# Copy to .env in the project root. NEVER commit .env.
# On an actual domain, DNS A/AAAA points to your VPS. Caddy obtains HTTPS certificates.
# For local smoke tests only: SITE_DOMAIN=:80 (HTTP)
SITE_DOMAIN=example.com
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=GENERATE_WITH_PYTHON_SECRETS_TOKEN_URLSAFE_64
DJANGO_ALLOWED_HOSTS=example.com,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
DJANGO_SECURE_SSL_REDIRECT=1
# Only the internal gateway is trusted to set proxy headers
TRUST_REVERSE_PROXY=1
POSTGRES_DB=haniel
POSTGRES_USER=haniel
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
POSTGRES_HOST=database
POSTGRES_PORT=5432
# Commerce integrations default to DISABLED until credentials and QA are completed
SMS_BACKEND=disabled
SERVIX_API_KEY=
GOLD_FEED_PROVIDER_NAME=servix
GOLD_FEED_MAX_SOURCE_AGE_SECONDS=2400
GOLD_FEED_VALID_SECONDS=2700
GOLD_FEED_MAX_CHANGE_PERCENT=5
QUOTE_VALID_SECONDS=600
ORDER_HOLD_SECONDS=900
