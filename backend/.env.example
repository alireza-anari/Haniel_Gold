DJANGO_DEBUG=1
DJANGO_SECRET_KEY=REPLACE-WITH-A-STRONG-RANDOM-SECRET
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
POSTGRES_DB=haniel
POSTGRES_USER=haniel
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
SMS_BACKEND=disabled
QUOTE_VALID_SECONDS=600
ORDER_HOLD_SECONDS=900
# Production: DEBUG=0, real TLS, real SMS provider adapter and verified payment adapter.

# Official Servix feed: Profile > API Keys; do not share key or commit .env.
GOLD_FEED_PROVIDER_NAME=servix
SERVIX_API_KEY=
# Always validate source time; stale observations do not become sale prices.
GOLD_FEED_MAX_SOURCE_AGE_SECONDS=2400
GOLD_FEED_VALID_SECONDS=2700
GOLD_FEED_MAX_CHANGE_PERCENT=5
# The generic licensed-feed adapter remains available but is NOT used by default.
GOLD_FEED_URL=
GOLD_FEED_ALLOWED_HOST=
GOLD_FEED_API_KEY=
GOLD_FEED_AUTH_HEADER=Authorization
GOLD_FEED_AUTH_PREFIX="Bearer "
GOLD_FEED_VALUE_PATH=
GOLD_FEED_TIMESTAMP_PATH=
GOLD_FEED_UNIT=
